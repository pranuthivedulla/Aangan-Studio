# Aangan enquiry agent — environment template.
# Copy to .env.local and fill in. Never commit a filled copy.
#
# Every adapter defaults to its mock. The whole pipeline runs end to end with
# this file untouched and no credentials anywhere (acceptance test T19).

# ---------------------------------------------------------------------------
# Adapter selection
# ---------------------------------------------------------------------------
# "mock" (default) or "real". Set per adapter to turn integrations on one at a
# time in Phase 7. ADAPTER_MODE sets the default for all of them.
ADAPTER_MODE=mock
# ADAPTER_MODE_VOICE=real
# ADAPTER_MODE_LLM=real
# ADAPTER_MODE_CALENDAR=real
# ADAPTER_MODE_CRM=real
# ADAPTER_MODE_NOTIFY=real
# ADAPTER_MODE_EMAIL=real
# ADAPTER_MODE_STORE=real

# ---------------------------------------------------------------------------
# Vaani Labs — telephony and voice
# ---------------------------------------------------------------------------
# Shape of these values is [verify]: vaanilabs.in docs were not reachable at
# Phase 1. See RUNBOOK.md "Vaani: what we still need to confirm".
VAANI_API_KEY=
VAANI_AGENT_ID=
VAANI_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Gemini Flash — extraction, classification, summaries, handoff note
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# Google Calendar (Cal.com / Calendly swap behind the same adapter)
# ---------------------------------------------------------------------------
GOOGLE_CALENDAR_CLIENT_EMAIL=
GOOGLE_CALENDAR_PRIVATE_KEY=
GOOGLE_CALENDAR_IMPERSONATE_SUBJECT=

# ---------------------------------------------------------------------------
# HubSpot — CRM
# ---------------------------------------------------------------------------
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_PORTAL_ID=

# ---------------------------------------------------------------------------
# Telegram — alerts. One bot, two chats.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_DESIGNER_CHAT_ID=
TELEGRAM_FRONTDESK_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET_TOKEN=

# ---------------------------------------------------------------------------
# Resend — email fallback for a designer with no Telegram binding
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_ADDRESS=

# ---------------------------------------------------------------------------
# Supabase — call log, cost, lead state, clocks, settings, rota
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# IANA zone. The working-minute clock and every timestamp depend on it.
APP_TIMEZONE=Asia/Kolkata
